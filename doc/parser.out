    este            reduce using rule 4 (instr -> norte .)
    norte           reduce using rule 4 (instr -> norte .)
    oeste           reduce using rule 4 (instr -> norte .)
    sur             reduce using rule 4 (instr -> norte .)
    $end            reduce using rule 4 (instr -> norte .)


state 6

